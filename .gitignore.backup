*.py[cod]
*$py.class
*.so
.Python
venv/
env/

# Jupyter Notebook
.ipynb_checkpoints
*.ipynb

# Keep processed data but exclude large intermediate files
data/processed/*.rds
data/processed/*.RData

# Documentation temp files
docs/~$*
